# Copiar a .env y completar. .env NUNCA se sube al repo (permisos 600).

# IA del launcher: deepseek | simulado
IA_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Mercado Pago Checkout Pro (opcional). Sin token: modo manual (link/alias).
# Access token: https://www.mercadopago.com.ar/developers/panel/app -> Credenciales
MERCADOPAGO_ACCESS_TOKEN=
# 1 = usar sandbox_init_point (credenciales de prueba)
MERCADOPAGO_SANDBOX=
# URL pública para back_urls y webhook (si no, se toma del request)
BASE_URL=https://dwday-38964763.online

# Google Calendar (opcional). Ver docs/google-calendar.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
